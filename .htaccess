Options -Indexes

# Enable URL Rewriting
RewriteEngine On

# DirectoryIndex priorities
DirectoryIndex index.php index.html

# Admin portal clean URL
RewriteRule ^admin/?$ /admin/index.php [L]

# Protect data folder
RewriteRule ^data/.*$ - [F,L]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL rewrites: /medicare → /medicare.html
RewriteRule ^medicare$ /medicare.html [L]
RewriteRule ^blog$ /blog.html [L]
RewriteRule ^tool$ /tool.html [L]
RewriteRule ^about$ /about.html [L]
RewriteRule ^404$ /404.html [L]

# Blog sub-pages
RewriteRule ^blog/([^/]+)$ /blog/$1.html [L]

# 404 fallback
ErrorDocument 404 /404.html
