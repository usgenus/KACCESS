DirectoryIndex index.php index.html

<IfModule mod_headers.c>
  # Default for web documents
  Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"

  # Media files MUST have byte-range caching for HTML5 video/audio streaming (no-store breaks Safari & Chromium)
  <FilesMatch "\.(mp4|webm|ogv|mov|m4v|mp3|ogg|wav)$">
    Header set Cache-Control "public, max-age=2592000"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  # Static assets (images, fonts, scripts, styles)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|css|js)$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect index.html to /
RewriteRule ^index\.html$ / [R=301,L]

# Admin clean URL
RewriteRule ^admin/?$ admin/index.php [L]

# Protect data folder
RewriteRule ^data/.*$ - [F,L]

# Auto-recovery for uploaded images and videos if missing on disk
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/(images|videos)/(.+)$ api/media.php?file=$2 [L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^medicare/?$ medicare.html [L]
RewriteRule ^matcher/?$ matcher.html [L]
RewriteRule ^calculator/?$ calculator.html [L]
RewriteRule ^dictionary/?$ dictionary.html [L]
RewriteRule ^blog/?$ blog.php [L]
RewriteRule ^senior-care/?$ senior-care.php [L]
RewriteRule ^tool/?$ tool.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^404/?$ 404.html [L]

# Dynamic blog post handler (MUST BE BEFORE static file/dir checks)
RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L]

# If requested file or directory exists, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404.html
