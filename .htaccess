DirectoryIndex index.php index.html

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"

  # Allow Service Worker across origin
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Media files byte-range caching
  <FilesMatch "\.(mp4|webm|ogv|mov|m4v|mp3|ogg|wav)$">
    Header set Cache-Control "public, max-age=2592000"
    Header set Accept-Ranges "bytes"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  # JavaScript and CSS: immediate revalidation so mobile browsers never get stuck on stale scripts
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Images and static media: long cache
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0. Leave /engine completely untouched
RewriteCond %{REQUEST_URI} ^/engine(/.*)?$ [NC]
RewriteRule ^ - [L]

# 0.2 Service Worker routing
RewriteRule ^sw\.js$ sw.js [L]
RewriteRule ^ko/sw\.js$ sw.js [L]

# 0.3 Sitemaps and robots.txt routing
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.txt [L]

# 0.4 Canonical redirect explicit index.html / index.php to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.(html|php) [NC]
RewriteRule ^index\.(html|php)$ / [R=301,L]

# 1. 301 Permanent Redirect all legacy /en/ and /ko/ paths to root domain hub
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^en/(.*)$ /$1 [R=301,L]
RewriteRule ^ko/?$ / [R=301,L]
RewriteRule ^ko/(.*)$ /$1 [R=301,L]

# 2. Clean routes for portal pages
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin2/?$ admin2/index.php [L]

RewriteRule ^forum/?$ forum/index.php [L]
RewriteRule ^forum/ask/?$ forum/ask.php [L]
RewriteRule ^forum/category/([^/]+)/?$ forum/index.php?specialty=$1 [L]
RewriteRule ^forum/topic/([^/]+)/?$ forum/topic.php?id=$1 [L]

RewriteRule ^blog/?$ blog.php [L]
RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L]

RewriteRule ^resource-center/?$ resource-center.html [L]
RewriteRule ^resources/?$ resource-center.html [L]
RewriteRule ^medicare/?$ resource-center.html [L]
RewriteRule ^resources/medicare/?$ resource-center.html [L]
RewriteRule ^navigation/?$ / [R=301,L]
RewriteRule ^news/?$ blog.php [L]
RewriteRule ^senior-care/?$ / [R=301,L]
RewriteRule ^tool/?$ / [R=301,L]
RewriteRule ^matcher/?$ matcher.html [L]
RewriteRule ^calculator/?$ calculator.html [L]
RewriteRule ^dictionary/?$ dictionary.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^404/?$ 404.html [L]

# 3. Fallbacks for uploads if missing in root but present in /ko/uploads
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/ko/uploads/$1 -f
RewriteRule ^uploads/(.*)$ /ko/uploads/$1 [L]

# 4. If requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404.html
