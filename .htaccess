<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Admin clean URL
RewriteRule ^admin/?$ admin/index.php [L]

# Protect data folder
RewriteRule ^data/.*$ - [F,L]

# If requested file or directory exists, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL rewrites
RewriteRule ^medicare/?$ medicare.html [L]
RewriteRule ^blog/?$ blog.html [L]
RewriteRule ^tool/?$ tool.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^404/?$ 404.html [L]

# Dynamic blog post fallback for CMS uploaded articles
RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]

RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L]
</IfModule>

ErrorDocument 404 /404.html
